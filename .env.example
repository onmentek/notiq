# Turso Veritabanı Bağlantısı (Vercel Environment Variables)
# Boş bırakılırsa yerel geliştirmede otomatik olarak file:./data/notes.db (libSQL) kullanılır.
TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Opsiyonel: Çoklu cihaz / Android APK senkronizasyonu için güvenlik anahtarı.
# Ayarlanırsa API isteklerinde Authorization: Bearer <SYNC_SECRET> gerekir.
# Boş bırakılırsa tek kullanıcı açık modda çalışır.
SYNC_SECRET=""

# Opsiyonel: Android APK derlemesinde varsayılan senkronizasyon sunucusu (ör: https://notiq.vercel.app)
NEXT_PUBLIC_DEFAULT_SYNC_URL=""
