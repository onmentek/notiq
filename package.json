{
  "name": "notiq",
  "version": "1.0.0",
  "private": true,
  "description": "Hızlı, akıllı ve yarı saydam etkileşimli not uygulaması — Vercel, Turso ve Android APK",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build:mobile": "node scripts/build-mobile.mjs",
    "android:sync": "npm run build:mobile && npx cap sync android",
    "android:apk": "npm run android:sync && node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@libsql/client": "^0.18.0",
    "lucide-react": "^1.76.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
